# Copy to `.env` and fill in. Only DJANGO_SECRET_KEY is required for local dev;
# without DATABASE_URL Django falls back to a local SQLite file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to fetch the API/media directly (the 3D viewer loads
# .glb files from the browser, so the frontend origin must be listed here).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Production only (docker compose) ---
# Postgres container credentials; docker-compose.yml builds DATABASE_URL from these.
POSTGRES_DB=harbiyinfo
POSTGRES_USER=harbiyinfo
POSTGRES_PASSWORD=change-me

# Redirect plain HTTP to HTTPS (behind nginx, which sets X-Forwarded-Proto).
# DJANGO_SECURE_SSL_REDIRECT=True

# Absolute media URL. API responses embed file URLs built from this, and the
# browser must be able to reach them (so NOT an internal container hostname).
# MEDIA_URL=https://your-domain.example/media/

# --- Email (optional; defaults to printing emails to the console) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
